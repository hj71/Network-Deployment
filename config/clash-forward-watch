#!/bin/sh

set -u

PFCTL=/sbin/pfctl
IFCONFIG=/sbin/ifconfig
AWK=/usr/bin/awk
GREP=/usr/bin/grep
PGREP=/usr/bin/pgrep
SLEEP=/bin/sleep
DATE=/bin/date

REFRESH=/usr/local/sbin/clash-forward-refresh
ANCHOR="clash-forward"
HOTSPOT_IF="bridge100"
HOTSPOT_IP="192.168.2.1"
HOTSPOT_NET="192.168.2.0/24"
TUN_IP="198.18.0.1"

LAST_STATE=""
FAILED_SIG=""

say() { printf '%s %s\n' "$("$DATE" '+%Y-%m-%d %H:%M:%S')" "$*"; }

set_state()
{
    NEW_STATE="$1"
    if [ "$NEW_STATE" != "$LAST_STATE" ]; then
        say "$NEW_STATE"
        LAST_STATE="$NEW_STATE"
    fi
}

main_anchor_present() { "$PFCTL" -sr 2>/dev/null | "$GREP" -Fq 'anchor "clash-forward"'; }

bridge_ready()
{
    "$IFCONFIG" "$HOTSPOT_IF" 2>/dev/null | "$AWK" -v target="$HOTSPOT_IP" '
        $1 == "inet" && $2 == target { found=1 }
        END { exit(found ? 0 : 1) }
    '
}

mihomo_ready() { "$PGREP" -x verge-mihomo >/dev/null 2>&1; }

find_tun()
{
    "$IFCONFIG" 2>/dev/null | "$AWK" -v target="$TUN_IP" '
        /^[[:alnum:]_.-]+: flags=/ { iface=$1; sub(/:$/, "", iface) }
        $1 == "inet" && $2 == target { print iface }
    '
}

rules_present() { "$PFCTL" -a "$ANCHOR" -sr 2>/dev/null | "$GREP" -q '[^[:space:]]'; }

rules_match_tun()
{
    CHECK_TUN="$1"
    RULES_NOW="$("$PFCTL" -a "$ANCHOR" -sr 2>/dev/null)"
    printf '%s\n' "$RULES_NOW" | "$GREP" -F "pass in quick on $HOTSPOT_IF route-to ($CHECK_TUN $TUN_IP)" | "$GREP" -Fq "proto tcp from $HOTSPOT_NET" || return 1
    printf '%s\n' "$RULES_NOW" | "$GREP" -F "pass in quick on $HOTSPOT_IF route-to ($CHECK_TUN $TUN_IP)" | "$GREP" -Fq "proto udp from $HOTSPOT_NET" || return 1
    return 0
}

disable_if_needed()
{
    REASON="$1"
    if rules_present; then
        set_state "DISABLING: $REASON"
        if "$REFRESH" --disable; then
            set_state "DISABLED: $REASON"
        else
            set_state "ERROR: disable failed: $REASON"
        fi
    else
        set_state "WAIT: $REASON"
    fi
}

reconcile()
{
    if ! main_anchor_present; then disable_if_needed "main PF anchor missing"; return; fi
    if ! bridge_ready; then disable_if_needed "$HOTSPOT_IF/$HOTSPOT_IP not ready"; return; fi
    if ! mihomo_ready; then disable_if_needed "verge-mihomo not running"; return; fi

    TUN_LIST="$(find_tun)"
    TUN_COUNT="$(printf '%s\n' "$TUN_LIST" | "$AWK" 'NF { count++ } END { print count+0 }')"
    if [ "$TUN_COUNT" -ne 1 ]; then disable_if_needed "expected one interface with $TUN_IP; found $TUN_COUNT"; return; fi

    TUN_IF="$(printf '%s\n' "$TUN_LIST" | "$AWK" 'NF { print; exit }')"
    if ! printf '%s\n' "$TUN_IF" | "$GREP" -Eq '^utun[0-9]+$'; then disable_if_needed "invalid TUN interface: $TUN_IF"; return; fi

    SIG="$HOTSPOT_IF:$TUN_IF"
    if rules_match_tun "$TUN_IF"; then FAILED_SIG=""; set_state "ACTIVE: TUN=$TUN_IF"; return; fi
    if [ "$FAILED_SIG" = "$SIG" ]; then set_state "ERROR-HOLD: previous apply failed for TUN=$TUN_IF"; return; fi

    CHECK_OUT="$("$REFRESH" --check 2>&1)"
    CHECK_RC=$?
    if [ "$CHECK_RC" -ne 0 ]; then
        if rules_present; then "$REFRESH" --disable; fi
        FAILED_SIG="$SIG"
        set_state "ERROR-HOLD: precheck failed for TUN=$TUN_IF"
        printf '%s\n' "$CHECK_OUT"
        return
    fi

    set_state "APPLYING: TUN=$TUN_IF"
    if "$REFRESH" --apply; then
        FAILED_SIG=""
        set_state "ACTIVE: TUN=$TUN_IF"
    else
        FAILED_SIG="$SIG"
        set_state "ERROR-HOLD: apply failed for TUN=$TUN_IF"
    fi
}

case "${1:-}" in
    --once) reconcile ;;
    "")
        trap 'exit 0' TERM INT HUP
        while :; do reconcile; "$SLEEP" 10; done
        ;;
    *) printf 'Usage: %s [--once]\n' "$0"; exit 64 ;;
esac
