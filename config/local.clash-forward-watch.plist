<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.clash-forward-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/sbin/clash-forward-watch</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/var/log/clash-forward-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/clash-forward-watch.err</string>
</dict>
</plist>
